# -----------------------------------------------------------------------------
# FlashLearn AI — Backend Environment Configuration Example
# Copy this file to '.env' and populate real credentials for local development.
# NEVER commit real credentials to git!
# -----------------------------------------------------------------------------

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="FlashLearn AI"
API_V1_STR="/api/v1"

# Security & Secrets
# Generate a secure secret in terminal: openssl rand -hex 32
SECRET_KEY=change-this-super-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flashlearn_db

# CORS Allowed Origins (Comma-separated list)
# In production, specify exact client domains (e.g., https://flashlearn.app)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini AI Key & Model
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=1024  # 1024 tokens = LOW reasoning mode (fast & cost-effective)

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_AI_GENERATE="10/minute"
